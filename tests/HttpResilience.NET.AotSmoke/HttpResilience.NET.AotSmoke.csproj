<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Publishing Native AOT proves the library's IsTrimmable and IsAotCompatible claims end to end. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <!-- An SDK older than 10.0.403 bundles a compiler flagged by GHSA-p3jp-9v83-76w9 (NU1903, an error here).
       global.json requires a patched SDK; this covers a machine that bypasses it. Conditional, so a newer SDK's
       own compiler is never replaced by an older one. -->
  <ItemGroup Condition="$([MSBuild]::VersionLessThan('$(BundledNETCoreAppPackageVersion)', '10.0.14'))">
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HttpResilience.NET\HttpResilience.NET.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generic host: SmokeScenarios starts real hosts, so the hosted services run under Native AOT too. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
