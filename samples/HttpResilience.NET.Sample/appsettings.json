{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "HttpResilience": {
    "Enabled": true,

    "Timeout": {
      "Total": "00:00:20",
      "Attempt": "00:00:05"
    },

    "Retry": {
      "Enabled": true,
      "MaxRetries": 2,
      "BaseDelay": "00:00:00.500",
      "BackoffType": "Exponential",
      "UseJitter": true,
      "UseRetryAfterHeader": true,
      "DisableForUnsafeHttpMethods": true
    },

    "CircuitBreaker": {
      "FailureRatio": 0.1,
      "MinimumThroughput": 100,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:05"
    },

    "Connection": {
      "Enabled": true,
      "PooledConnectionLifetime": "00:02:00",
      "PooledConnectionIdleTimeout": "00:01:00",
      "ConnectTimeout": "00:00:02",
      "EnableMultipleHttp2Connections": true
    },

    "Clients": {
      "Orders": {
        "Timeout": { "Total": "00:00:12", "Attempt": "00:00:03" },
        "CircuitBreaker": { "SamplingDuration": "00:00:30" }
      },

      // Retries POST because the endpoint deduplicates on an idempotency key.
      "Payments": {
        "Timeout": { "Total": "00:00:18", "Attempt": "00:00:05" },
        "Retry": { "MaxRetries": 2, "RetryableMethods": [ "GET", "POST" ] }
      },

      // Hedged for tail latency. Selected in code with AddHedgedHttpResilience.
      "Search": {
        "Timeout": { "Total": "00:00:06", "Attempt": "00:00:02" },
        "Connection": { "ConnectTimeout": "00:00:01" },
        "CircuitBreaker": { "SamplingDuration": "00:00:30" },
        "Hedging": { "Delay": "00:00:00.300", "MaxHedgedAttempts": 1 },
        "PipelineSelection": { "Authorities": [ "https://origin.example" ] },
        "RateLimiter": {
          "Enabled": true,
          "Algorithm": "TokenBucket",
          "TokenLimit": 200,
          "TokensPerPeriod": 100,
          "ReplenishmentPeriod": "00:00:01",
          "QueueLimit": 0
        }
      },

      // One client, several hosts. Authorities are allow-listed so pipeline count is fixed.
      "Partner": {
        "Timeout": { "Total": "00:00:20", "Attempt": "00:00:05" },
        "ConcurrencyLimiter": { "Enabled": true, "Limit": 20, "QueueLimit": 50 },
        "PipelineSelection": {
          "Mode": "ByAuthority",
          "Authorities": [ "https://a.partner.example", "https://b.partner.example" ]
        }
      }
    }
  }
}
